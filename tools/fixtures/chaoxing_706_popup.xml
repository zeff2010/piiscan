="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,883][914,1003]" /><node index="4" text="3. 我们会采用先进的安全措施保护您的信息安全；" resource-id="com.chaoxing.mobile:id/tv_part4" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1022][914,1142]" /><node index="5" text="4. 未经您同意，我们不会从第三方获取、共享或向其提供您的任何信息；" resource-id="com.chaoxing.mobile:id/tv_part5" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1161][914,1281]" /><node index="6" text="5. 您可以查询、更新、删除您的个人信息，我们也提供账户注销的渠道。" resource-id="com.chaoxing.mobile:id/tv_part6" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1300][914,1420]" /><node index="7" text="6. 登录后可在我-设置-关于模块下，查找并阅读《隐私政策》和《用户协议》。" resource-id="com.chaoxing.mobile:id/tv_part7" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1439][914,1559]" /><node index="8" text="" resource-id="" class="android.widget.LinearLayout" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1625][914,1886]"><node index="0" text="同意" resource-id="com.chaoxing.mobile:id/tv_accept" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1625][914,1735]" /><node index="1" text="不同意" resource-id="com.chaoxing.mobile:id/tv_not_accept" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[166,1776][914,1886]" /></node><node index="9" text="未满14周岁？请先征得监护人同意" resource-id="com.chaoxing.mobile:id/tv_teenager_hint" class="android.widget.TextView" package="com.chaoxing.mobile" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[245,1941][835,1994]" /></node></node></node></node></node></node></node></hierarchy>